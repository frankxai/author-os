# Arcanea Author Cockpit production environment
# Copy values into Vercel Project Settings or add them with `vercel env add`.
# Do not commit real secrets. This file contains placeholders only.

# RUNTIME
# Disables the sample project adapter in hosted production.
AUTHOROS_DEMO_MODE=false
# Requires verified tenant identity before serving project data.
AUTHOROS_REQUIRE_AUTH=true

# AUTH
# Selects Clerk as the first hosted auth provider.
AUTHOROS_AUTH_PROVIDER=clerk
# Keeps raw tenant identity headers disabled unless a reviewed gateway injects them.
AUTHOROS_ALLOW_TRUSTED_AUTH_HEADERS=false
# Clerk server secret key.
CLERK_SECRET_KEY=sk_live_replace_me
# Clerk browser publishable key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
# Hosted sign-in route.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Hosted sign-up route.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional post-auth workspace landing paths. Off-site URLs are ignored by the app.
NEXT_PUBLIC_AUTHOROS_AFTER_SIGN_IN_URL=/projects
NEXT_PUBLIC_AUTHOROS_AFTER_SIGN_UP_URL=/projects
# OAuth authorization server advertised by hosted MCP protected-resource metadata.
AUTHOROS_MCP_AUTHORIZATION_SERVER_URL=https://auth.replace-me.example.com

# ENTITLEMENTS
# Fallback plan until Stripe entitlement events become the source of truth.
AUTHOROS_DEFAULT_PLAN=cloud-creator
# Fallback role for authenticated users without explicit workspace claims.
AUTHOROS_DEFAULT_AUTH_ROLE=editor

# DATA
# Forces hosted persistence through the tenant-scoped Postgres adapter.
AUTHOROS_PROJECT_ADAPTER=postgres
# Declares the verified schema version applied to the target database.
AUTHOROS_DB_MIGRATION_VERSION=001_author_os_cloud
# Audit identity recorded by the migration runner.
AUTHOROS_MIGRATION_APPLIED_BY=author-os-cli
# Caps the hosted Postgres pool per server instance.
AUTHOROS_PG_POOL_MAX=5
# Closes idle Postgres connections promptly in serverless runtimes.
AUTHOROS_PG_IDLE_TIMEOUT_MS=5000
# Vercel Marketplace Postgres connection string. DATABASE_URL is accepted as an alias.
POSTGRES_URL=postgres://user:password@host.neon.tech/db?sslmode=require

# APP
# Canonical HTTPS URL for auth callbacks, webhooks, and public links.
NEXT_PUBLIC_APP_URL=https://author.arcanea.ai

# ASSETS
# Vercel Blob token for private author assets.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# BILLING
# Stripe server secret key.
STRIPE_SECRET_KEY=sk_live_replace_me
# Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Stripe browser publishable key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
# Optional Stripe Customer Portal configuration id for subscription management sessions.
STRIPE_BILLING_PORTAL_CONFIGURATION=bpc_replace_me
# Stripe recurring price for Pro Local.
STRIPE_PRICE_PRO_LOCAL=price_replace_pro_local
# Stripe recurring price for Cloud Creator.
STRIPE_PRICE_CLOUD_CREATOR=price_replace_cloud_creator
# Stripe recurring price for Cloud Studio.
STRIPE_PRICE_CLOUD_STUDIO=price_replace_cloud_studio
# Stripe recurring price for Agency / Small Press.
STRIPE_PRICE_AGENCY_SMALL_PRESS=price_replace_agency_small_press

# OFFERS
# Launch price for founder lifetime local access.
STRIPE_PRICE_FOUNDER_LIFETIME_LOCAL=price_replace_founder_lifetime
# One-time Stripe price for the first paid Foundry Pack.
STRIPE_PRICE_FOUNDRY_PACK=price_replace_foundry_pack
# Launch price for concierge setup.
STRIPE_PRICE_CONCIERGE_SETUP=price_replace_concierge_setup
# Launch price for agentic service sprints.
STRIPE_PRICE_AGENTIC_SERVICE_SPRINT=price_replace_service_sprint

# AI
# Vercel AI Gateway key for managed agent runs. VERCEL_AI_GATEWAY_API_KEY is accepted as an alias.
AI_GATEWAY_API_KEY=vck_replace_me
# AI Gateway model ids are deployment configuration. Check the current Gateway model catalog before setting them.
AUTHOROS_MODEL_EXTRACTOR=provider/model-from-ai-gateway-catalog
AUTHOROS_MODEL_CONTINUITY=provider/model-from-ai-gateway-catalog
AUTHOROS_MODEL_PROSE=provider/model-from-ai-gateway-catalog
AUTHOROS_MODEL_VISUAL=provider/model-from-ai-gateway-catalog
AUTHOROS_MODEL_OPERATIONS=provider/model-from-ai-gateway-catalog
# Optional Gateway provider/model fallback policy.
AUTHOROS_AI_PROVIDER_ORDER=anthropic,bedrock
AUTHOROS_AI_FALLBACK_MODELS=provider/fallback-model
# Pre-flight budgets for managed model calls.
AUTHOROS_AI_MAX_INPUT_TOKENS=24000
AUTHOROS_AI_MAX_OUTPUT_TOKENS=1200

# OBSERVABILITY
# Sentry DSN for production error capture.
SENTRY_DSN=https://replace@sentry.io/project
# PostHog browser key for activation analytics.
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me
# PostHog host.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# VERIFICATION
# Vercel Protection Bypass for Automation secret used by live preview verification. VERCEL_AUTOMATION_BYPASS_SECRET is accepted as an alias.
AUTHOROS_VERCEL_PROTECTION_BYPASS=vercel_protection_bypass_replace_me
